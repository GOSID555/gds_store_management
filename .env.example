# API
# ไม่ตั้ง DATABASE_URL = ใช้ PGlite (Postgres แบบฝังในไฟล์ .pgdata) สำหรับ dev
# DATABASE_URL=postgres://pos:pos@localhost:5432/pos
# ค่าเริ่มต้นต้องเข้าสู่ระบบ; false = โหมดทดลอง ไม่ต้องเข้าสู่ระบบ (ใครเปิดเว็บก็เป็นเจ้าของร้าน)
# REQUIRE_LOGIN=false
# ไม่ตั้งก็ได้ (สร้างจาก DATABASE_URL)
JWT_SECRET=change-me-to-a-long-random-string
PORT=3001
CORS_ORIGIN=http://localhost:5173
OWNER_USERNAME=owner
# ไม่ตั้ง = ตั้งบัญชีเจ้าของร้านจากหน้าเว็บครั้งแรก
OWNER_PASSWORD=change-me
